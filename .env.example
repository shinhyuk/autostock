# ── 실행 모드 ───────────────────────────────────────────────
# paper    : KIS 실시간 시세 + 가상 체결 (주문은 전혀 나가지 않음)  ← 여기서 시작
# kis-demo : KIS 모의투자 계좌로 실제 주문 API 호출
# live     : 실계좌 주문. LIVE_TRADING_CONFIRM=I_UNDERSTAND 필요
MODE=paper
LIVE_TRADING_CONFIRM=

# ── Claude ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
DECISION_INTERVAL_SEC=180      # AI 판단 주기 (짧을수록 API 비용 증가)

# ── 한국투자증권 Open API ──────────────────────────────────
# paper 모드는 시세 조회만 하므로 실전/모의 어느 키든 됩니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT=01         # 계좌번호 뒤 2자리
KIS_ENV=demo                   # 위 키가 모의투자용이면 demo, 실전용이면 real

# ── 자금 / 목표 ────────────────────────────────────────────
CAPITAL_KRW=1000000
DAILY_TARGET_KRW=100000        # 도달 시 전량 청산 후 당일 종료
DAILY_MAX_LOSS_KRW=50000       # 도달 시 전량 청산 후 당일 종료
USDKRW=1400                    # 원/달러 환율 (직접 맞춰주세요)

# ── 리스크 한도 (AI가 넘을 수 없는 코드 레벨 한도) ─────────
MAX_STOP_LOSS_PCT=2.0          # 1회 거래 최대 손절폭
DEFAULT_TAKE_PROFIT_PCT=3.0
MAX_TRADES_PER_DAY=8
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSS_MIN=10
MIN_CONFIDENCE=0.6
NO_ENTRY_AFTER_OPEN_MIN=5
NO_ENTRY_BEFORE_CLOSE_MIN=20
FLATTEN_BEFORE_CLOSE_MIN=5
FEE_PCT=0.25                   # 편도 수수료 % (본인 계좌 수수료율로 수정)
TICK_SEC=10                    # 손절/익절 감시 주기
