#!/usr/bin/env bash
# 서버 운영용 단축 명령. 폰 브라우저 터미널에서도 짧게 칠 수 있게 만든 것.
#   ./bot setup            자동 실행 + 자동 업데이트 등록 (처음 한 번)
#   ./bot check            키/연결 점검 (주문 없음)
#   ./bot status           실행 상태와 오늘 손익
#   ./bot logs             실시간 로그 (Ctrl+C 로 나가기)
#   ./bot mode <paper|kis-demo|live>   모드 변경 후 재시작
#   ./bot web              결과 웹페이지 켜기 (주소 출력)
#   ./bot update [--force] GitHub 최신 코드 받아서 재시작
#   ./bot start|stop|restart
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
DIR=$PWD
PY=$DIR/.venv/bin/python
mode() { grep -E '^MODE=' .env 2>/dev/null | head -1 | cut -d= -f2 | awk '{print $1}'; }
has_position() {
  $PY - "$DIR/data/state_$(mode).json" <<'PY'
import json, sys
try:
    sys.exit(0 if json.load(open(sys.argv[1])).get("open") else 1)
except FileNotFoundError:
    sys.exit(1)
PY
}

case "${1:-}" in
setup)
  sudo tee /etc/systemd/system/autostock.service >/dev/null <<EOF
[Unit]
Description=autostock trading bot
After=network-online.target
Wants=network-online.target

[Service]
User=$USER
WorkingDirectory=$DIR
ExecStart=$PY -m autostock
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
  sudo tee /etc/systemd/system/autostock-update.service >/dev/null <<EOF
[Unit]
Description=autostock auto update

[Service]
Type=oneshot
User=$USER
ExecStart=$DIR/bot update
EOF
  sudo tee /etc/systemd/system/autostock-update.timer >/dev/null <<EOF
[Unit]
Description=autostock auto update every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable --now autostock autostock-update.timer
  echo "등록 완료. './bot status' 로 확인하세요."
  ;;
check) $PY -m autostock --check ;;
status)
  echo "모드: $(mode)   서비스: $(systemctl is-active autostock || true)   코드: $(git log -1 --format='%h %s')"
  $PY - "$DIR/data/state_$(mode).json" <<'PY'
import json, sys
try:
    s = json.load(open(sys.argv[1]))
except FileNotFoundError:
    sys.exit("아직 매매 상태 없음 (장이 열린 적 없음)")
print(f"거래일 {s['date']}  실현손익 ${s['realized_usd']:+.2f}  거래 {s['trades']}회 (승 {s['wins']}/패 {s['losses']})"
      f"  종료사유: {s['halted'] or '-'}")
print("보유:", s["open"] or "없음")
for h in s["history"][-8:]:
    print(f"  {h['ts']} {h['symbol']} {h['qty']}주 {h['entry']}→{h['exit']}  ${h['pnl_usd']:+.2f}  {h['reason']}")
PY
  journalctl -u autostock -n 5 --no-pager -o cat || true
  ;;
logs) journalctl -u autostock -f -o cat ;;
mode)
  m=${2:-}
  [[ $m =~ ^(paper|kis-demo|live)$ ]] || { echo "사용법: ./bot mode paper|kis-demo|live"; exit 1; }
  if has_position; then echo "보유 포지션이 있어 모드를 바꿀 수 없습니다. 청산된 뒤(장 마감 후) 다시 하세요."; exit 1; fi
  confirm=""
  if [[ $m == live ]]; then
    read -r -p "실계좌에서 실제 돈으로 주문이 나갑니다. 계속하려면 LIVE 라고 입력: " a
    [[ $a == LIVE ]] || { echo "취소됨"; exit 1; }
    confirm=I_UNDERSTAND
  fi
  sed -i -E "s/^MODE=.*/MODE=$m/; s/^LIVE_TRADING_CONFIRM=.*/LIVE_TRADING_CONFIRM=$confirm/" .env
  sudo systemctl restart autostock
  echo "모드 → $m. './bot logs' 로 확인하세요."
  ;;
update)
  br=$(git rev-parse --abbrev-ref HEAD)
  git fetch -q origin "$br"
  [[ $(git rev-parse HEAD) == $(git rev-parse FETCH_HEAD) ]] && { echo "이미 최신"; exit 0; }
  if [[ ${2:-} != --force ]] && has_position; then echo "보유 포지션이 있어 업데이트를 미룹니다"; exit 0; fi
  git merge -q --ff-only FETCH_HEAD
  "$DIR/.venv/bin/pip" install -q -r requirements.txt
  sudo systemctl restart autostock
  if systemctl is-enabled -q autostock-web 2>/dev/null; then sudo systemctl restart autostock-web; fi
  echo "업데이트 완료: $(git log -1 --format='%h %s')"
  ;;
web)
  tok=$(grep -E '^WEB_TOKEN=' .env | head -1 | cut -d= -f2 | awk '{print $1}' || true)
  if [[ ${#tok} -lt 16 ]]; then
    tok=$($PY -c 'import secrets; print(secrets.token_urlsafe(18))')
    sed -i '/^WEB_TOKEN=/d' .env
    printf '\nWEB_TOKEN=%s\n' "$tok" >> .env
  fi
  sudo tee /etc/systemd/system/autostock-web.service >/dev/null <<EOF
[Unit]
Description=autostock results page
After=network-online.target

[Service]
User=$USER
WorkingDirectory=$DIR
ExecStart=$PY -m autostock.web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable -q autostock-web
  sudo systemctl restart autostock-web
  ip=$(curl -s --max-time 5 https://checkip.amazonaws.com || echo "서버IP")
  echo "결과 페이지 주소 (즐겨찾기 해두세요. 이 주소를 아는 사람은 누구나 볼 수 있습니다):"
  echo "  http://$ip:8080/?k=$tok"
  echo "안 열리면 AWS 보안 그룹에서 TCP 8080 인바운드를 허용해야 합니다."
  ;;
start|stop|restart) sudo systemctl "$1" autostock ;;
*) sed -n '2,10p' "$0" ;;
esac
