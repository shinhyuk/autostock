#!/usr/bin/env bash
# 서버 운영용 단축 명령. 폰 브라우저 터미널에서도 짧게 칠 수 있게 만든 것.
#   ./bot setup            자동 실행 + 자동 업데이트 등록 (처음 한 번)
#   ./bot check            키/연결 점검 (주문 없음)
#   ./bot ordertest [모드] kis-demo/live 로 1주 매수→매도 테스트 (장중에만)
#   ./bot buy [종목] [수량]  실계좌에서 지금 사서 보유만 (기본 SOXL 1주, 팔지 않음)
#   ./bot status           실행 상태와 오늘 손익
#   ./bot logs             실시간 로그 (Ctrl+C 로 나가기)
#   ./bot mode <paper|kis-demo|live>   모드 변경 후 재시작 (동시 실행: ./bot mode kis-demo,live)
#   ./bot web              결과 웹페이지 켜기 (주소 출력)
#   ./bot update [--force] GitHub 최신 코드 받아서 재시작
#   ./bot start|stop|restart
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
DIR=$PWD
PY=$DIR/.venv/bin/python
mode() { grep -E '^MODE=' .env 2>/dev/null | head -1 | cut -d= -f2 | awk '{print $1}'; }
modes() { mode | tr ',' ' '; }
has_position() {   # 실계좌(live)가 포지션을 들고 있으면 참. 가상·모의는 재시작해도 상태 파일로 복원된다
  local m
  for m in $(modes); do
    [[ $m == live ]] || continue
    # 진입한 지 2일 넘은 포지션은 봇 장부에만 남은 오래된 기록으로 보고 업데이트를 막지 않는다
    if $PY -c 'import json,sys,datetime
try:
    o=json.load(open(sys.argv[1])).get("open")
    ok=bool(o) and (datetime.datetime.now(datetime.timezone.utc)-datetime.datetime.fromisoformat(o["entry_ts"])).total_seconds()<2*86400
    sys.exit(0 if ok else 1)
except (FileNotFoundError, ValueError, KeyError, TypeError): sys.exit(1)' "$DIR/data/state_$m.json"; then return 0; fi
  done
  return 1
}

set_mode() {       # .env 의 MODE 와 실계좌 확인값을 바꾼다
  local confirm=""
  [[ ,$1, == *,live,* ]] && confirm=I_UNDERSTAND
  sed -i -E "s/^MODE=.*/MODE=$1/; s/^LIVE_TRADING_CONFIRM=.*/LIVE_TRADING_CONFIRM=$confirm/" .env
}
set_key() {        # .env 의 KEY 값을 바꾸거나, 없으면 추가
  if grep -q -E "^$1=" .env; then sed -i -E "s|^$1=.*|$1=$2|" .env; else printf '%s=%s\n' "$1" "$2" >> .env; fi
}
sync_settings() {  # 저장소의 deploy/settings 가 바뀌었으면 서버 .env 에 적용 (폰에서 설정을 바꾸기 위한 장치)
  [[ -f deploy/settings ]] || return 0
  local sum; sum=$(sha256sum < deploy/settings | cut -c1-16)
  [[ $(cat data/.applied_settings 2>/dev/null) == "$sum" ]] && return 0
  # 보유 중이어도 적용한다: 봇은 재시작해도 상태 파일에서 보유 포지션을 이어받아 손절·익절로 관리한다
  local k v
  while IFS='=' read -r k v; do
    [[ $k =~ ^((PAPER|DEMO|LIVE)__)?(MODE|CLAUDE_MODEL|CLAUDE_EFFORT|DECISION_INTERVAL_SEC|NO_ENTRY_AFTER_OPEN_MIN|MAX_TRADES_PER_DAY|MAX_CONSECUTIVE_LOSSES|COOLDOWN_AFTER_LOSS_MIN|TRAIL_ATR_MULT|TRAIL_MIN_PCT|SURGE_PCT|SESSIONS|MIN_CONFIDENCE|BULL_SYMBOL|BEAR_SYMBOL|CONTEXT_SYMBOLS|MAX_STOP_LOSS_PCT|TAKE_PROFIT_MAX_PCT|MAX_HOLD_MIN|DEFAULT_TAKE_PROFIT_PCT|STYLE|STRATEGY|EXT_STRATEGY|ORB_MINUTES|ORB_WINDOW_MIN|ORB_MAX_TRADES|ORB_STOP_PCT|ORB_TAKE_PCT|ORB_TRAIL_PCT|ORB_PEERS|ORB_STOP_MODE|NOISE|NOISE_LOOKBACK|NOISE_EVERY|NOISE_STOP_PCT|BOX|BOX_ZONE|BOX_TARGET|BOX_STOP|BOX_MAX|BOX_MIN_WIDTH|BOX_PEER_MAX|BOX_GAP_MAX|FIXED_QTY|NEWS_PICK|VOL_FILTER_MIN|RISK_PER_TRADE_PCT|ORDER_TEST_SYMBOL|ORDER_TEST_SELL|CAPITAL_KRW|DAILY_TARGET_KRW|DAILY_MAX_LOSS_KRW)$ && $v =~ ^[A-Za-z0-9_.,-]+$ ]] || continue
    if [[ $k == MODE ]]; then
      [[ $v =~ ^(paper|kis-demo|live)(,(paper|kis-demo|live))*$ ]] || continue
      set_mode "$v"
    else
      set_key "$k" "$v"
    fi
    echo "저장소 설정 적용: $k=$v"
  done < deploy/settings
  mkdir -p data
  echo "$sum" > data/.applied_settings
  sudo systemctl restart autostock
  if systemctl is-enabled -q autostock-web 2>/dev/null; then sudo systemctl restart autostock-web; fi
}

case "${1:-}" in
setup)
  sudo tee /etc/systemd/system/autostock.service >/dev/null <<EOF
[Unit]
Description=autostock trading bot
After=network-online.target
Wants=network-online.target

[Service]
User=$USER
WorkingDirectory=$DIR
ExecStart=$PY -m autostock
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
  sudo tee /etc/systemd/system/autostock-update.service >/dev/null <<EOF
[Unit]
Description=autostock auto update

[Service]
Type=oneshot
User=$USER
ExecStart=$DIR/bot update
EOF
  sudo tee /etc/systemd/system/autostock-update.timer >/dev/null <<EOF
[Unit]
Description=autostock auto update every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable --now autostock autostock-update.timer
  echo "등록 완료. './bot status' 로 확인하세요."
  ;;
check) $PY -m autostock --check ;;
ordertest)
  m=${2:-$(modes | awk '{print $1}')}
  if [[ $m == live ]]; then
    read -r -p "실계좌에서 SOXL 1주를 실제로 샀다가 팝니다. 계속하려면 LIVE 입력: " a
    [[ $a == LIVE ]] || { echo "취소됨"; exit 1; }
  fi
  $PY -m autostock --mode "$m" --order-test
  ;;
buy)
  sym=${2:-SOXL}; qty=${3:-1}
  [[ $sym =~ ^[A-Za-z]{1,6}$ && $qty =~ ^[0-9]{1,3}$ ]] || { echo "사용법: ./bot buy SOXL 1"; exit 1; }
  read -r -p "실계좌에서 ${sym^^} ${qty}주를 지금 사서 보유합니다 (팔지 않음). 계속하려면 y: " a
  [[ $a == y ]] || { echo "취소됨"; exit 1; }
  $PY -m autostock --mode live --buy "$sym" --qty "$qty"
  ;;
status)
  echo "모드: $(mode)   서비스: $(systemctl is-active autostock || true)   코드: $(git log -1 --format='%h %s')"
  for m in $(modes); do
    echo "── $m ──"
    $PY - "$DIR/data/state_$m.json" "$DIR/data/ordertest_$m.ok" <<'PY' || true
import json, os, sys
try:
    s = json.load(open(sys.argv[1]))
except FileNotFoundError:
    sys.exit("아직 매매 상태 없음 (장이 열린 적 없음)")
print(f"거래일 {s['date']}  실현손익 ${s['realized_usd']:+.2f}  거래 {s['trades']}회 (승 {s['wins']}/패 {s['losses']})"
      f"  종료사유: {s['halted'] or '-'}")
if "paper" not in sys.argv[1]:
    print("주문 테스트:", "통과" if os.path.exists(sys.argv[2]) else "아직")
print("보유:", s["open"] or "없음")
for h in s["history"][-8:]:
    print(f"  {h['ts']} {h['symbol']} {h['qty']}주 {h['entry']}→{h['exit']}  ${h['pnl_usd']:+.2f}  {h['reason']}")
PY
  done
  journalctl -u autostock -n 8 --no-pager -o cat || true
  ;;
logs) journalctl -u autostock -f -o cat ;;
mode)
  m=${2:-}
  [[ $m =~ ^(paper|kis-demo|live)(,(paper|kis-demo|live))*$ ]] || {
    echo "사용법: ./bot mode paper|kis-demo|live  (여러 개 동시 실행은 쉼표로: kis-demo,live)"; exit 1; }
  if has_position; then echo "보유 포지션이 있어 모드를 바꿀 수 없습니다. 청산된 뒤(장 마감 후) 다시 하세요."; exit 1; fi
  confirm=""
  if [[ ,$m, == *,live,* ]]; then
    read -r -p "실계좌에서 실제 돈으로 주문이 나갑니다. 계속하려면 LIVE 라고 입력: " a
    [[ $a == LIVE ]] || { echo "취소됨"; exit 1; }
    confirm=I_UNDERSTAND
  fi
  set_mode "$m"
  sudo systemctl restart autostock
  echo "모드 → $m. './bot logs' 로 확인하세요."
  ;;
update)
  br=$(git rev-parse --abbrev-ref HEAD)
  git fetch -q origin "$br"
  if [[ $(git rev-parse HEAD) == $(git rev-parse FETCH_HEAD) ]]; then sync_settings; echo "이미 최신"; exit 0; fi
  # 보유 포지션이 있어도 업데이트한다 (재시작 후 상태 파일로 이어받음). 예전에는 미뤘는데, 테스트로 산 1주 때문에
  # 모든 모드의 업데이트가 멈추는 문제가 있었다.
  git merge -q --ff-only FETCH_HEAD
  "$DIR/.venv/bin/pip" install -q -r requirements.txt
  sudo systemctl restart autostock
  if systemctl is-enabled -q autostock-web 2>/dev/null; then sudo systemctl restart autostock-web; fi
  echo "업데이트 완료: $(git log -1 --format='%h %s')"
  ;;
web)
  tok=$(grep -E '^WEB_TOKEN=' .env | head -1 | cut -d= -f2 | awk '{print $1}' || true)
  if [[ ${#tok} -lt 16 ]]; then
    tok=$($PY -c 'import secrets; print(secrets.token_urlsafe(18))')
    sed -i '/^WEB_TOKEN=/d' .env
    printf '\nWEB_TOKEN=%s\n' "$tok" >> .env
  fi
  sudo tee /etc/systemd/system/autostock-web.service >/dev/null <<EOF
[Unit]
Description=autostock results page
After=network-online.target

[Service]
User=$USER
WorkingDirectory=$DIR
ExecStart=$PY -m autostock.web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable -q autostock-web
  sudo systemctl restart autostock-web
  ip=$(curl -s --max-time 5 https://checkip.amazonaws.com || echo "서버IP")
  echo "결과 페이지 주소 (즐겨찾기 해두세요. 이 주소를 아는 사람은 누구나 볼 수 있습니다):"
  echo "  http://$ip:8080/?k=$tok"
  echo "안 열리면 AWS 보안 그룹에서 TCP 8080 인바운드를 허용해야 합니다."
  ;;
start|stop|restart) sudo systemctl "$1" autostock ;;
*) sed -n '2,10p' "$0" ;;
esac
