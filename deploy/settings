# 서버 운영 설정. 이 파일이 바뀌면 서버가 5분 안에 .env 에 반영하고 봇을 재시작한다.
# (포지션 보유 중이면 청산될 때까지 미룸. 비밀 값은 여기에 적지 않는다.)
# 모드별로 다르게 하려면 PAPER__ / DEMO__ / LIVE__ 접두어를 붙인다. 사용할 수 있는 키는 bot 의 sync_settings 참고.
MODE=paper,kis-demo,live
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=high
DECISION_INTERVAL_SEC=180
NO_ENTRY_AFTER_OPEN_MIN=2
MAX_TRADES_PER_DAY=16
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_AFTER_LOSS_MIN=10
SESSIONS=regular,day,pre
MIN_CONFIDENCE=0.45

# 실계좌: 계좌 1200만원 중 1000만원은 레버리지 ETP 기본예탁금으로 두고, 200만원만 SOXL/SOXS 에 운용.
#  모의투자와 같은 검증된 설정(개장 범위 돌파 + 박스권 하루 1회 + 변동성 필터 + 손절 시 자본 3%만 잃도록 수량 조절).
#  주간거래를 켜 둔 이유: 첫 주문 테스트로 SOXL 1주를 사서 보유(바로 팔지 않음). 주간거래 중 매매 전략은 돌지 않는다(정규장에서만).
#  테스트로 산 1주는 손절·익절에 닿거나 그 세션 마감 5분 전(주간거래는 한국 17:10)에 정리된다.
BULL_SYMBOL=SOXL
BEAR_SYMBOL=SOXS
CONTEXT_SYMBOLS=NVDA,SOXX,AMD,AVGO,TSM,MU,QQQ
LIVE__BULL_SYMBOL=SOXL
LIVE__BEAR_SYMBOL=SOXS
LIVE__CONTEXT_SYMBOLS=NVDA,SOXX,AMD,AVGO,TSM,MU,QQQ
LIVE__ORDER_TEST_SYMBOL=SOXL
LIVE__ORDER_TEST_SELL=false
LIVE__STRATEGY=orb
# 주문 테스트(주간거래 11/25 10:02 SOXL 1주)는 끝났으므로 실계좌는 정규장만. 프리·주간거래에서는 테스트 외 매매가 없었다
LIVE__SESSIONS=regular
LIVE__CAPITAL_KRW=2000000
LIVE__DAILY_TARGET_KRW=200000
LIVE__DAILY_MAX_LOSS_KRW=200000
LIVE__ORB_MINUTES=20
# 사용자 요청(11/26): 288개 조합 탐색의 추천 설정 — 돌파 60분·2회 · 익절 15% · 분할매수 절반→+1% · 금액 조절 없음 · 박스 무제한
LIVE__ORB_WINDOW_MIN=60
LIVE__ORB_MAX_TRADES=2
LIVE__ORB_STOP_MODE=mid
LIVE__ORB_TAKE_PCT=15
LIVE__ORB_TRAIL_PCT=0
LIVE__ORB_PEERS=NVDA,SOXX
LIVE__BOX=true
LIVE__BOX_ZONE=0.2
LIVE__BOX_TARGET=0.8
LIVE__BOX_STOP=0.1
LIVE__BOX_MAX=0
LIVE__BOX_MIN_WIDTH=5
LIVE__MAX_STOP_LOSS_PCT=6
LIVE__TAKE_PROFIT_MAX_PCT=30
LIVE__VOL_FILTER_MIN=8
LIVE__RISK_PER_TRADE_PCT=0
LIVE__SCALE_IN_FRAC=0.5
LIVE__SCALE_IN_ADD_PCT=1
LIVE__TRAIL_MIN_PCT=0.6

# 모의투자: 1000만원으로 SOXL/SOXS, 정규장만. (모든 탭: 매일 다시 채우지 않고 누적 손익을 반영한 자산으로 매매) 가상매매(기존 돌파 설정)와 나란히 비교하는 개선안:
#  돌파(진입 마감 60분, 추적 손절 없음, 손절은 범위 중간값) + 범위 안 박스권 매매 (research/README.md)
DEMO__STRATEGY=orb
DEMO__SESSIONS=regular
DEMO__ORB_MINUTES=20
DEMO__ORB_WINDOW_MIN=60
DEMO__ORB_MAX_TRADES=2
DEMO__ORB_STOP_MODE=mid
DEMO__ORB_TAKE_PCT=10
DEMO__ORB_TRAIL_PCT=0
DEMO__ORB_PEERS=NVDA,SOXX
DEMO__BOX=true
DEMO__BOX_ZONE=0.2
DEMO__BOX_TARGET=0.8
DEMO__BOX_STOP=0.1
DEMO__BOX_MAX=1
DEMO__BOX_MIN_WIDTH=5
DEMO__MAX_STOP_LOSS_PCT=6
DEMO__TAKE_PROFIT_MAX_PCT=10
# 변동성 필터(최근 5일 평균 하루 변동폭 8% 미만이면 쉼) + 손절 시 자본 3%만 잃도록 수량 조절
DEMO__VOL_FILTER_MIN=8
DEMO__RISK_PER_TRADE_PCT=3
DEMO__BULL_SYMBOL=SOXL
DEMO__BEAR_SYMBOL=SOXS
DEMO__CONTEXT_SYMBOLS=NVDA,SOXX,AMD,AVGO,TSM,MU,QQQ
DEMO__TRAIL_MIN_PCT=0.6
DEMO__CAPITAL_KRW=10000000
DEMO__DAILY_TARGET_KRW=1000000
DEMO__DAILY_MAX_LOSS_KRW=1000000

# 가상매매: 1000만원 가정, 정규장만. 노이즈 영역 돌파 + 개장 범위 돌파 + 박스권 + 변동성 필터 (금액 조절 없음)
#  (research/combo.py: 45거래일 +292만, 최대 낙폭 -13.1%). 모의투자(노이즈 없음, 금액 조절)와 비교
PAPER__STRATEGY=orb
# 가상매매는 모든 시간에: 정규장은 돌파·박스권·노이즈, 프리·애프터·주간거래는 시간외 고정 박스 (Claude 호출 없음)
# 사용자 요청: 정규장 밖에서는 쉬지 않고 사고판다 (가짜 돈, 100주 고정). 정규장은 기존 돌파·박스권·노이즈
PAPER__EXT_STRATEGY=always
PAPER__FIXED_QTY=100
# 30분마다 사고팔면 수수료만 쌓여(11/26 사용자 지적) → 한 번 사면 손절 3% · 익절 5% · 세션 마감까지 보유, 청산 뒤 60분 쉼
PAPER__ALWAYS_HOLD_MIN=0
PAPER__ALWAYS_STOP_PCT=3
PAPER__ALWAYS_TAKE_PCT=5
PAPER__ALWAYS_COOLDOWN_MIN=60
# 뉴스 호재·악재 실험: 주간거래·프리마켓 시작 때 Claude 가 기사 제목으로 SOXL/SOXS 를 고르고(하루 2번 호출), 그 방향으로만 산다
PAPER__NEWS_PICK=true
PAPER__SESSIONS=regular,pre,post,day
PAPER__BULL_SYMBOL=SOXL
PAPER__BEAR_SYMBOL=SOXS
PAPER__CONTEXT_SYMBOLS=NVDA,SOXX,AMD,AVGO,TSM,MU,QQQ
PAPER__CAPITAL_KRW=10000000
PAPER__DAILY_TARGET_KRW=1000000
PAPER__DAILY_MAX_LOSS_KRW=3000000
PAPER__ORB_MINUTES=20
# 288개 조합 탐색 결과(research/README.md "조합 탐색") 가장 고른 설정: 돌파 60분·2회 · 익절 15% · 분할매수 절반→+1% · 금액 조절 없음 · 박스 무제한
PAPER__ORB_WINDOW_MIN=60
PAPER__ORB_MAX_TRADES=2
# 분할매수: 돌파 때 절반만 사고, 보유 종목이 +1% 가면 나머지 (60일: -15.8% → -4.7%, 최대 낙폭 -37% → -23%)
PAPER__SCALE_IN_FRAC=0.5
PAPER__SCALE_IN_ADD_PCT=1
PAPER__ORB_STOP_MODE=mid
PAPER__ORB_STOP_PCT=1.5
# 11/24 피드백: 돌파 익절 10% → 6% 실험 (20일 엔진 재생 모의 설정 기준 +408만 → +447만, 11/24 -30만 → -7만). 실계좌도 6% (사용자 요청), 모의투자는 10% 유지하고 비교
PAPER__ORB_TAKE_PCT=15
PAPER__ORB_TRAIL_PCT=0
PAPER__ORB_PEERS=NVDA,SOXX
PAPER__BOX=true
PAPER__BOX_ZONE=0.2
PAPER__BOX_TARGET=0.8
PAPER__BOX_STOP=0.1
