# 서버 운영 설정. 이 파일이 바뀌면 서버가 5분 안에 .env 에 반영하고 봇을 재시작한다.
# (포지션 보유 중이면 청산될 때까지 미룸. 비밀 값은 여기에 적지 않는다.)
# 모드별로 다르게 하려면 PAPER__ / DEMO__ / LIVE__ 접두어를 붙인다. 사용할 수 있는 키는 bot 의 sync_settings 참고.
MODE=paper,kis-demo,live
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=high
DECISION_INTERVAL_SEC=180
NO_ENTRY_AFTER_OPEN_MIN=2
MAX_TRADES_PER_DAY=16
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_AFTER_LOSS_MIN=10
SESSIONS=regular,day,pre
MIN_CONFIDENCE=0.45

# 실계좌: 레버리지 ETF 는 기본예탁금 요건 때문에 보류. 17만원으로 여러 주 살 수 있는 인텔만 매수·매도
BULL_SYMBOL=INTC
BEAR_SYMBOL=NONE
CONTEXT_SYMBOLS=NVDA,SOXX,QQQ,AMD,AVGO,TSM,MU
TRAIL_MIN_PCT=0.3
LIVE__ORDER_TEST_SYMBOL=INTC
LIVE__ORDER_TEST_SELL=false

# 모의투자: 100만원으로 SOXL/SOXS
DEMO__BULL_SYMBOL=SOXL
DEMO__BEAR_SYMBOL=SOXS
DEMO__CONTEXT_SYMBOLS=NVDA,SOXX,AMD,AVGO,TSM,MU,QQQ
DEMO__TRAIL_MIN_PCT=0.6
DEMO__CAPITAL_KRW=1000000
DEMO__DAILY_TARGET_KRW=100000
DEMO__DAILY_MAX_LOSS_KRW=100000

# 가상매매: 100만원으로 SOXL/SOXS 분 단위 초단타 실험
PAPER__BULL_SYMBOL=SOXL
PAPER__BEAR_SYMBOL=SOXS
PAPER__CONTEXT_SYMBOLS=NVDA,SOXX,AMD,AVGO,TSM,MU,QQQ
PAPER__TRAIL_MIN_PCT=0.4
PAPER__CAPITAL_KRW=1000000
PAPER__DAILY_TARGET_KRW=100000
PAPER__DAILY_MAX_LOSS_KRW=200000
PAPER__STYLE=aggressive
PAPER__DECISION_INTERVAL_SEC=60
PAPER__MIN_CONFIDENCE=0.2
PAPER__MAX_TRADES_PER_DAY=300
PAPER__MAX_CONSECUTIVE_LOSSES=100
PAPER__COOLDOWN_AFTER_LOSS_MIN=0
PAPER__SURGE_PCT=0.5
